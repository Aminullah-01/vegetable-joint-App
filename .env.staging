# ==============================================================================
# Vegetable Joint — Staging Environment Configuration (.env.staging)
# Conforms to SRS NFR-SEC-03, NFR-SEC-10, and Section 4.5
# ==============================================================================
VITE_APP_NAME="Vegetable Joint (Staging)"
VITE_APP_ENV="staging"
VITE_APP_ORIGIN="https://staging.vegetablejoint.ng"
VITE_ALLOWED_ORIGINS="https://staging.vegetablejoint.ng"

# Laravel REST API Base URL & CSRF cookie endpoint
VITE_API_BASE_URL="https://staging-api.vegetablejoint.ng/api/v1"
VITE_SANCTUM_CSRF_URL="https://staging-api.vegetablejoint.ng/sanctum/csrf-cookie"

# Token handling strategy: HttpOnly cookie preferred (NFR-SEC-03)
VITE_AUTH_TOKEN_STRATEGY="cookie"
VITE_API_WITH_CREDENTIALS="true"

# Mock / API Data Switch
VITE_USE_MOCK_DATA="false"
