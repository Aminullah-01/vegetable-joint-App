# ==============================================================================
# Vegetable Joint — Production Environment Configuration (.env.production)
# Conforms to SRS NFR-SEC-03, NFR-SEC-10, and Section 4.5
# ==============================================================================
VITE_APP_NAME="Vegetable Joint"
VITE_APP_ENV="production"
VITE_APP_ORIGIN="https://vegetablejoint.ng"
VITE_ALLOWED_ORIGINS="https://vegetablejoint.ng,https://www.vegetablejoint.ng"

# Laravel REST API Base URL & CSRF cookie endpoint
VITE_API_BASE_URL="https://api.vegetablejoint.ng/api/v1"
VITE_SANCTUM_CSRF_URL="https://api.vegetablejoint.ng/sanctum/csrf-cookie"

# Token handling strategy: HttpOnly cookie preferred (NFR-SEC-03)
VITE_AUTH_TOKEN_STRATEGY="cookie"
VITE_API_WITH_CREDENTIALS="true"

# Mock / API Data Switch
VITE_USE_MOCK_DATA="false"
