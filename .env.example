# ==============================================================================
# Vegetable Joint — Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' or '.env.local' for local development.
# 2. Never commit secrets, private keys, or passwords to version control (NFR-SEC-09).
# ==============================================================================

# Application Metadata
VITE_APP_NAME="Vegetable Joint"
VITE_APP_ENV="development"

# Laravel REST API Base URL (versioned under /api/v1 as per SRS Section 4.4 / CON-03)
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Mock / API Data Switch (NFR-MAIN-02, FE-003, FE-012)
# Set to 'true' to use local mock data fixtures (front-end first development).
# Set to 'false' to communicate with the live Laravel REST API.
VITE_USE_MOCK_DATA="true"
