# ==============================================================================
# Vegetable Joint — Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' or '.env.local' for local development.
# 2. Never commit secrets, private keys, or passwords to version control (NFR-SEC-09).
# 3. For staging deployments, reference '.env.staging'.
# 4. For production deployments, reference '.env.production'.
# ==============================================================================

# Application Metadata & Origin
VITE_APP_NAME="Vegetable Joint"
VITE_APP_ENV="development" # 'development' | 'staging' | 'production'
VITE_APP_ORIGIN="http://localhost:3000"

# CORS Allowed Front-End Origins (NFR-SEC-10, Section 4.5)
# Comma-separated list of approved front-end origins permitted to access the backend API.
# Development: "http://localhost:3000,http://127.0.0.1:3000"
# Staging:     "https://staging.vegetablejoint.ng"
# Production:  "https://vegetablejoint.ng,https://www.vegetablejoint.ng"
VITE_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Laravel REST API Base URL (versioned under /api/v1 as per SRS Section 4.4 / CON-03)
# Development: "http://localhost:8000/api/v1"
# Staging:     "https://staging-api.vegetablejoint.ng/api/v1"
# Production:  "https://api.vegetablejoint.ng/api/v1"
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Laravel Sanctum CSRF Cookie Endpoint (NFR-SEC-03, NFR-SEC-06)
# Seed endpoint for retrieving the XSRF-TOKEN cookie prior to authenticated mutations.
# Development: "http://localhost:8000/sanctum/csrf-cookie"
# Staging:     "https://staging-api.vegetablejoint.ng/sanctum/csrf-cookie"
# Production:  "https://api.vegetablejoint.ng/sanctum/csrf-cookie"
VITE_SANCTUM_CSRF_URL="http://localhost:8000/sanctum/csrf-cookie"

# Token Handling Strategy (SRS NFR-SEC-03, IF-05)
# 'cookie': HttpOnly cookie (preferred to minimise XSS exposure).
#           Tokens are managed exclusively via browser cookies and HTTP headers.
# 'bearer': Authorization: Bearer <token> stored in memory / localStorage.
VITE_AUTH_TOKEN_STRATEGY="cookie"

# Cross-Origin Credentials (CORS withCredentials)
# Must be 'true' when using cookie authentication across CORS domains.
VITE_API_WITH_CREDENTIALS="true"

# Mock / API Data Switch (NFR-MAIN-02, FE-003, FE-012)
# Set to 'true' to use local mock data fixtures (front-end first development).
# Set to 'false' to communicate with the live Laravel REST API.
VITE_USE_MOCK_DATA="true"
